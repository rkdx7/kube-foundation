*.dec.yaml

# Certificates and private keys
*.key
*.crt
*.pem
config/registry/certs/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Terraform state
terraform/.terraform/
terraform/*.tfstate*
